# Copy to .env.local for automatic first-run setup, or use the setup wizard.
# Keep .env.local private; it is ignored by Git.
JULES_API_KEY=
GITHUB_TOKEN=

# All five connection values above and below must be filled for automatic setup.
# The repository and branch are verified against both Jules and GitHub.
DEFAULT_GITHUB_OWNER=
DEFAULT_GITHUB_REPO=
DEFAULT_BASE_BRANCH=

# Optional research defaults. These are used during automatic setup.
RESEARCH_RUNTIME=30-60
DEVELOPMENT_SEEDS=5
FINAL_SEEDS=10
CONCURRENCY=10
