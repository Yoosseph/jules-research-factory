# Copy to .env (or .env.local) and fill in your keys, then restart the app.
# Both files are ignored by Git. Nonempty API keys replace saved keys on startup.
# Jules API key: https://jules.google.com/settings
JULES_API_KEY=
# NVIDIA API Catalog key for the orchestrator (separate from the Jules key).
NVIDIA_API_KEY=
# GitHub token for repository checks.
GITHUB_TOKEN=

# Jules key, GitHub token, owner, repository, and branch enable first-run setup.
# The repository and branch are verified against both Jules and GitHub.
DEFAULT_GITHUB_OWNER=
DEFAULT_GITHUB_REPO=
DEFAULT_BASE_BRANCH=

# Optional research defaults. These are used during automatic setup.
RESEARCH_RUNTIME=30-60
DEVELOPMENT_SEEDS=5
FINAL_SEEDS=10
CONCURRENCY=10
